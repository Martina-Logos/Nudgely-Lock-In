generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String?
  displayName        String
  username           String?             @unique
  avatarUrl          String?
  timezone           String              @default("UTC")
  role               UserRole?
  isEmailVerified    Boolean             @default(false)
  isOnboarded        Boolean             @default(false)
  focusTime          FocusTime?
  emotionalState     EmotionalState?
  distractions       Distraction[]
  mainGoal           MainGoal?
  weeklyGoal         String?
  personalityVibe    PersonalityVibe?
  temperament        Temperament?
  iqScore            Int?
  eqScore            Int?
  sqScore            Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  focusSessions      FocusSession[]
  habits             Habit[]
  journalEntries     JournalEntry[]
  meditationSessions MeditationSession[]
  otpCodes           OtpCode[]
  refreshTokens      RefreshToken[]
  routines           Routine[]
  tasks              Task[]
  weeklyReports      WeeklyReport[]
  chatMessages       ChatMessage[]
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpCode {
  id        String     @id @default(uuid())
  code      String
  userId    String
  purpose   OtpPurpose @default(EmailVerification)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_codes")
}

model Task {
  id               String         @id @default(uuid())
  userId           String
  title            String
  naturalInput     String?
  drive            Drive          @default(OnFire)
  status           TaskStatus     @default(Todo)
  priority         TaskPriority   @default(GoodToDo)
  estimatedMinutes Int?
  dueDate          DateTime?
  completedAt      DateTime?
  aiSuggested      Boolean        @default(false)
  aiNudge          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  focusSessions    FocusSession[]
  subtasks         Subtask[]
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, drive])
  @@index([userId, status])
  @@map("tasks")
}

model Subtask {
  id               String    @id @default(uuid())
  taskId           String
  title            String
  estimatedMinutes Int?
  completed        Boolean   @default(false)
  completedAt      DateTime?
  order            Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  task             Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("subtasks")
}

model Habit {
  id           String            @id @default(uuid())
  userId       String
  name         String
  emoji        String            @default("✅")
  type         HabitType         @default(Build)
  frequency    HabitFrequency    @default(Daily)
  strength     HabitStrength     @default(Weak)
  streak       Int               @default(0)
  bestStreak   Int               @default(0)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  completions  HabitCompletion[]
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineItems RoutineItem[]

  @@index([userId])
  @@map("habits")
}

model HabitCompletion {
  id          String   @id @default(uuid())
  habitId     String
  completedAt DateTime @default(now())
  date        String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
  @@map("habit_completions")
}

model Routine {
  id        String        @id @default(uuid())
  userId    String
  name      String
  time      String?
  type      String        @default("Morning")
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  items     RoutineItem[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("routines")
}

model RoutineItem {
  id        String  @id @default(uuid())
  routineId String
  habitId   String?
  label     String
  order     Int     @default(0)
  habit     Habit?  @relation(fields: [habitId], references: [id])
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([routineId])
  @@map("routine_items")
}

model JournalEntry {
  id           String   @id @default(uuid())
  userId       String
  text         String?
  tags         String[]
  moodScore    Int
  sleepQuality Int?
  date         String
  aiInsight    String?
  aiPromptUsed Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("journal_entries")
}

model FocusSession {
  id              String    @id @default(uuid())
  userId          String
  taskId          String?
  durationMinutes Int
  completed       Boolean   @default(true)
  interrupted     Boolean   @default(false)
  startedAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  task            Task?     @relation(fields: [taskId], references: [id])
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, startedAt])
  @@map("focus_sessions")
}

model MeditationSession {
  id              String         @id @default(uuid())
  userId          String
  mode            MeditationMode
  durationMinutes Int
  completed       Boolean        @default(true)
  startedAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("meditation_sessions")
}

model WeeklyReport {
  id             String   @id @default(uuid())
  userId         String
  weekStart      DateTime
  weekEnd        DateTime
  totalFocusMin  Int      @default(0)
  tasksDone      Int      @default(0)
  avgMood        Float    @default(0)
  dailyFocusData Json     @default("[]")
  moodTrendData  Json     @default("[]")
  wins           String[]
  tips           String[]
  aiSummary      String?
  suggestions    String?
  generatedAt    DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId])
  @@map("weekly_reports")
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chat_messages")
}

enum UserRole {
  Student
  Professional
  Creator
  Entrepreneur
}

enum Temperament {
  Sanguine
  Choleric
  Melancholic
  Phlegmatic
}

enum PersonalityVibe {
  Soft
  Bold
}

enum FocusTime {
  Morning
  Afternoon
  Evening
  Night
}

enum EmotionalState {
  Anxious
  Energetic
  Calm
  Overwhelmed
}

enum Distraction {
  SocialMedia
  RacingThoughts
  OtherPeople
  Perfectionism
}

enum MainGoal {
  StayingFocused
  BeatingProcrastination
  BuildingHabits
  ManagingADHD
}

enum Drive {
  OnFire
  DueSoon
  LowLift
  OpenSpace
}

enum TaskStatus {
  Todo
  WorkingOnIt
  PushedBack
  StuckOnThis
  Done
}

enum TaskPriority {
  NonNegotiable
  GoodToDo
  IfIGetThere
}

enum HabitType {
  Build
  Quit
}

enum HabitStrength {
  Weak
  Moderate
  High
}

enum HabitFrequency {
  Daily
  Weekdays
  Custom
}

enum MeditationMode {
  Focus
  Calm
  Sleep
  Energy
}

enum OtpPurpose {
  EmailVerification
  PasswordReset
}
